# Copy to .env and `export $(cat .env | xargs)` (or load with python-dotenv) before running.

# "http" (default, no extra infra needed) or "mqtt"
AWTRIX_TRANSPORT=http

# --- HTTP transport ---
AWTRIX_HOST=192.168.1.50
AWTRIX_HTTP_TIMEOUT=2.0

# --- MQTT transport (only used when AWTRIX_TRANSPORT=mqtt) ---
AWTRIX_MQTT_BROKER=127.0.0.1
AWTRIX_MQTT_PORT=1883
AWTRIX_MQTT_USER=
AWTRIX_MQTT_PASSWORD=
# Must match the device name configured in AWTRIX's own MQTT settings page
AWTRIX_MQTT_PREFIX=awtrix_xxxx

# Optional: name of a custom icon you uploaded in the AWTRIX web UI (Icons -> Upload, 8x8).
# Leave blank to render text-only (works out of the box, no upload needed).
AWTRIX_ICON_CAT=
